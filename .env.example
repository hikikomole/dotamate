NODE_ENV=production
DOMAIN=stream.example.com
PUBLIC_ORIGIN=https://stream.example.com
# WebRTC signaling is proxied by Caddy at https://media.<DOMAIN>; ICE/UDP uses the same host on 8189.
PUBLIC_MEDIA_HOST=media.stream.example.com
POSTGRES_DB=dota2helper
POSTGRES_USER=dota2helper
TURN_REALM=turn.stream.example.com
TURN_SECRET=replace-with-long-turn-secret
CLOUDPAYMENTS_PUBLIC_ID=
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_DAYS=7
