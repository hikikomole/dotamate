NODE_ENV=production
DOMAIN=stream.example.com
PUBLIC_ORIGIN=https://stream.example.com
# WebRTC signaling is proxied by Caddy at https://media.<DOMAIN>; ICE/UDP uses the same host on 8189.
PUBLIC_MEDIA_HOST=media.stream.example.com
POSTGRES_DB=dota2helper
POSTGRES_USER=dota2helper
TURN_REALM=turn.stream.example.com
TURN_SECRET=replace-with-long-turn-secret
CLOUDPAYMENTS_PUBLIC_ID=
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_DAYS=7

# Делегирование рутины бесплатным моделям (см. tools/llm.py и раздел
# "Делегирование рутины" в CLAUDE.md). Не обязательны для работы сайта —
# нужны только когда Claude отдаёт объёмную задачу внешней модели.
# Заполнять не обязательно все: llm.py перебирает только тех, у кого есть
# ключ, а остальных молча пропускает. Проверить, кто жив: llm.py --check
# Groq:       https://console.groq.com/keys
# Gemini:     https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# Cloudflare Workers AI — тот же аккаунт, где хостится сайт, но токен нужен
# отдельный, с правом только Workers AI. ID аккаунта виден в адресной строке
# панели Cloudflare (dash.cloudflare.com/<это и есть ID>).
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Ollama (локальные модели на самой машине) ключа не требует вовсе:
# llm.py -p ollama ходит на 127.0.0.1:11434, лимитов там нет.

# Деплой сайта: Cloudflare -> My Profile -> API Tokens -> Create Token,
# шаблон "Edit Cloudflare Workers". Токен даёт право записи, в чат и во
# внешние модели не отправлять (см. раздел про токены доступа в CLAUDE.md).
CLOUDFLARE_API_TOKEN=
