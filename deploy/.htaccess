# Generated from deploy/_headers (Cloudflare/Netlify format) for Apache
Options -Indexes
DirectoryIndex index.html
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.webvisor.org https://mc.yandex.ru https://mc.yandex.com https://yandex.ru https://*.yandex.ru https://*.yandex.net https://*.yandex.com https://yastatic.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://yastatic.net; font-src 'self' https://fonts.gstatic.com https://yastatic.net; img-src 'self' data: https:; media-src 'self' https://cdn.steamstatic.com https://cdn.akamai.steamstatic.com https://cdn.cloudflare.steamstatic.com; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com https://mc.webvisor.org https://*.yandex.ru https://*.yandex.net https://*.yandex.com https://cloudflareinsights.com https://static.cloudflareinsights.com wss://mc.yandex.ru wss://mc.yandex.com wss://*.yandex.ru wss://*.yandex.net wss://*.yandex.com; frame-src https://*.yandex.ru https://*.yandex.net https://*.yandex.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/xml application/xml image/svg+xml
</IfModule>
<FilesMatch "^(_headers|\.assetsignore|worker\.js|wrangler\.jsonc)$">
  Require all denied
</FilesMatch>

# /api/* -> api/index.php (замена Cloudflare Worker с 26.09.2026)
# и постоянные переадресации со старых адресов предметов (были в воркере).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^item/(dagon_[2-5])/?$ https://dotamate.ru/item/dagon/ [R=301,L]
  RewriteRule ^item/(necronomicon_[23])/?$ https://dotamate.ru/item/necronomicon/ [R=301,L]
  RewriteRule ^item/aghanims_shard_roshan/?$ https://dotamate.ru/item/aghanims_shard/ [R=301,L]
  RewriteRule ^item/ultimate_scepter_roshan/?$ https://dotamate.ru/item/ultimate_scepter_2/ [R=301,L]
  RewriteRule ^item/tango_single/?$ https://dotamate.ru/item/tango/ [R=301,L]
  RewriteRule ^api/(dota/|feedback$) api/index.php [L]
</IfModule>
